<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox with user-selected file access (open/save panels). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- App-scoped security bookmarks so "Open Recent" can reopen files. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Outgoing connections for the GitHub Releases update check. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Sparkle: allow the sandboxed app to reach its installer/status XPC
         services (names are <bundle-id>-spki / -spks). Required for in-place
         updates or Sparkle fails with "error launching the installer". -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.kikiplan.simplespread-spks</string>
        <string>com.kikiplan.simplespread-spki</string>
    </array>
</dict>
</plist>
